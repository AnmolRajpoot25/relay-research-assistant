# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Primary model (better quality, 12K TPM, 1K RPD, 100K TPD)
PRIMARY_MODEL=llama-3.3-70b-versatile

# Fallback model (faster, 6K TPM, 14.4K RPD, 500K TPD)
FALLBACK_MODEL=llama-3.1-8b-instant

# Mock service URL (used when all real quotas are exhausted)
MOCK_SERVICE_URL=http://localhost:8001

# Logging level
LOG_LEVEL=INFO
